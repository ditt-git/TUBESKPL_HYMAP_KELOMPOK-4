using System;
using System.Collections.Generic;
using System.Text;
using HYMAPSOPIR.Contracts;

namespace HYMAPSOPIR
{

    public class Pelanggan : EntitasDasar<string>
    {


        public const int SIKLUS_HARI_PENGIRIMAN = 7;

        public string IdPelanggan => Id;

        public string NamaPelanggan { 
            get; 
        }
        public string Alamat { 
            get; 
        }
        public Armada Wilayah { 
            get; 
        }

        public DateTime TanggalTerakhirKirim { 
            get; 
            private set;
        }

        public Pelanggan(string id, string nama, string alamat, Armada wilayah, DateTime terakhirKirim)
        {
            // PRECONDITION: Validasi input
            Contract.Require(!string.IsNullOrWhiteSpace(id), "ID Pelanggan tidak boleh kosong");
            Contract.Require(!string.IsNullOrWhiteSpace(nama), "Nama Pelanggan tidak boleh kosong");
            Contract.Require(!string.IsNullOrWhiteSpace(alamat), "Alamat tidak boleh kosong");
            Contract.Require(terakhirKirim <= DateTime.Now, "Tanggal terakhir kirim tidak boleh di masa depan");

            Id = id; 
            NamaPelanggan = nama;
            Alamat = alamat;
            TanggalTerakhirKirim = terakhirKirim;
            Wilayah = wilayah;

            // POSTCONDITION: Verifikasi state setelah konstruksi
            Contract.Ensure(!string.IsNullOrWhiteSpace(IdPelanggan), "IdPelanggan harus valid setelah konstruksi");
            Contract.Ensure(NamaPelanggan == nama, "NamaPelanggan harus sama dengan input");
        }

    
        public void UpdateTanggalPengirimanBerhasil(DateTime tanggalKirimBaru)
        {
            // PRECONDITION: Tanggal baru harus valid
            Contract.Require(tanggalKirimBaru <= DateTime.Now, "Tanggal pengiriman tidak boleh di masa depan");
            Contract.Require(tanggalKirimBaru >= TanggalTerakhirKirim, "Tanggal pengiriman baru tidak boleh lebih awal dari tanggal terakhir");

            DateTime tanggalSebelum = TanggalTerakhirKirim;
            TanggalTerakhirKirim = tanggalKirimBaru;

            // POSTCONDITION: Verifikasi perubahan berhasil dilakukan
            Contract.Ensure(TanggalTerakhirKirim == tanggalKirimBaru, "Tanggal pengiriman harus terupdate");
            Contract.Ensure(TanggalTerakhirKirim >= tanggalSebelum, "Tanggal pengiriman tidak boleh mundur");
        }

        // Menghitung jadwal berikutnya (Siklus 7 Hari)
        public DateTime JadwalBerikutnya()
        {
            // INVARIANT: Tanggal terakhir kirim harus valid
            Contract.Invariant(TanggalTerakhirKirim <= DateTime.Now, "Tanggal terakhir kirim harus valid");

            DateTime hasilJadwal = TanggalTerakhirKirim.AddDays(SIKLUS_HARI_PENGIRIMAN);

            // POSTCONDITION: Hasil harus lebih besar dari tanggal terakhir
            Contract.Ensure(hasilJadwal > TanggalTerakhirKirim, "Jadwal berikutnya harus lebih besar dari tanggal terakhir kirim");
            Contract.Ensure((hasilJadwal - TanggalTerakhirKirim).Days == SIKLUS_HARI_PENGIRIMAN, "Selisih jadwal harus tepat 7 hari");

            return hasilJadwal;
        }
    }
}

